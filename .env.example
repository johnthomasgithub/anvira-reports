# Copy this file to `.env` for local development, and add the same two values
# in Netlify → Site configuration → Environment variables.
# Both come from Supabase → Project Settings → API (use the anon / publishable key, never the service_role key).
# Leave them empty to run in "local mode" (reports saved in the browser only).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
